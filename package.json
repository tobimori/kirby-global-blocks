{
	"name": "kirby-global-blocks",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "kirbyup src/index.js",
		"dev": "kirbyup dev src/index.js",
		"format": "oxfmt",
		"lint": "eslint src",
		"playground": "PHP_CLI_SERVER_WORKERS=4 php -S ${HOST:-127.0.0.1}:${PORT:-8000} -t .playground .playground/kirby/router.php",
		"playground:portless": "portless run --name global-blocks pnpm playground"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.11.0",
		"eslint-plugin-unicorn": "^76.0.0",
		"eslint-plugin-vue": "^10.11.0",
		"globals": "^17.12.0",
		"kirbyup": "^4.0.0",
		"oxfmt": "^0.62.0",
		"portless": "^0.15.13"
	},
	"packageManager": "pnpm@11.20.0"
}
