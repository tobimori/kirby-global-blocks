{
	"name": "tobimori/kirby-global-blocks",
	"description": "Reusable global blocks for Kirby blocks and layout fields",
	"type": "kirby-plugin",
	"version": "0.1.1",
	"license": "proprietary",
	"autoload": {
		"psr-4": {
			"tobimori\\GlobalBlocks\\": "classes/"
		}
	},
	"require": {
		"php": ">=8.3.0",
		"getkirby/composer-installer": "^1.2.1"
	},
	"require-dev": {
		"getkirby/cms": "^5.5",
		"carthage-software/mago": "^1.50"
	},
	"scripts": {
		"build": "pnpm build",
		"dist": "composer install --no-dev --optimize-autoloader",
		"fix": "mago format"
	},
	"config": {
		"allow-plugins": {
			"getkirby/composer-installer": true
		},
		"optimize-autoloader": true
	},
	"conflict": {
		"getkirby/cms": "<5.5"
	},
	"extra": {
		"kirby-cms-path": false,
		"kirby": {
			"compatible": "^5.5"
		}
	}
}
